.building-menu-container {
    max-width: 320px;
    margin-top: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
    margin-right: 15px;
    align-items: flex-start;
    background-color: rgb(228, 227, 220);
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
}

.building-menu-title {
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    align-self: stretch;
}

.building-menu-buttons {
    flex-grow: 1; 
    align-self: stretch;
}

.building-menu-button {
    font-size: 24px;
    -unity-font-style: bold;
    background-color: rgba(255, 243, 164, 0.39);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    cursor: url("project://database/Assets/Sprites/UI/Cursor.png?fileID=2800000&guid=79d5402db9c71b848a9ec023f8218562&type=3#Cursor");
    color: rgb(33, 33, 33);
    align-self: stretch;
}

.building-menu-button:hover {
    background-color: rgba(235, 212, 66, 0.89);
}

.building-menu-button.selected {
    background-color: rgba(215, 198, 71, 0.89);
}

.building-menu-button:active {
    background-color: rgba(215, 198, 71, 0.89);
    color: rgb(255, 255, 255);
}
